FASTN_API_KEY=your_fastn_api_key_here
FASTN_WORKSPACE_ID=your_fastn_workspace_id_here
# Published workflow ids from each workflow's API tab (wf_...). Omit to stay simulated.
FASTN_WORKFLOW_HUBSPOT=
FASTN_WORKFLOW_SLACK=
FASTN_WORKFLOW_GMAIL=
FASTN_WORKFLOW_SHEETS=
FASTN_WORKFLOW_TWILIO=
# auto (default) | live | simulated
FASTN_MODE=auto
FASTN_TIMEOUT_MS=7000
# Optional x-fastn-env header value
FASTN_ENV=
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-5-haiku-latest
PORT=3001
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3001
# Optional: Vercel Blob store token. When absent, logs/connector state stay in memory.
BLOB_READ_WRITE_TOKEN=
