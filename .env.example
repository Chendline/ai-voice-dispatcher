# AEGIS backend runtime
PORT=3001
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3001

# AI providers — set at least one. Keys are read only by the backend.
AI_DEFAULT_PROVIDER=
AI_DEFAULT_MODEL=
AI_TIMEOUT_MS=45000

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MODELS=
ANTHROPIC_BASE_URL=https://api.anthropic.com

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_MODELS=
OPENAI_BASE_URL=https://api.openai.com/v1

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-pro
GOOGLE_MODELS=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1
OPENROUTER_MODELS=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODELS=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional self-hosted / OpenAI-compatible endpoint.
AI_COMPATIBLE_NAME=
AI_COMPATIBLE_BASE_URL=
AI_COMPATIBLE_API_KEY=
AI_COMPATIBLE_MODEL=
AI_COMPATIBLE_MODELS=

# Dispatch
DISPATCH_TIMEOUT_MS=8000
# Only for local testing. Keep false in production.
DISPATCH_ALLOW_INSECURE=false

# Optional durable workspace state (agents, targets, conversations, logs).
BLOB_READ_WRITE_TOKEN=
AEGIS_STATE_ID=default
